# TypeSafe AI API Credentials
# Obtain your key from: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Local Ollama Endpoint (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama Fast Proxy (Default: http://127.0.0.1:11435)
# Enforces reasoning_effort='none' and 32k context for OpenCode & AI coding agents
OLLAMA_PROXY_HOST=http://127.0.0.1:11435
